{
  "name": "fico",
  "version": "0.1.0",
  "private": true,
  "description": "FiCo — Autonomous Financial Ledger & Net-Tariff Orchestration Engine (FL-NTOE)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint --if-present",
    "db:generate": "pnpm --filter @fico/db generate",
    "db:migrate": "pnpm --filter @fico/db migrate:dev",
    "db:push": "pnpm --filter @fico/db push",
    "dev:api": "pnpm --filter @fico/api dev",
    "dev:workers": "pnpm --filter @fico/workers dev"
  },
  "engines": {
    "node": ">=20"
  }
}
