# ─── Infrastructure ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://fico:fico@localhost:5432/fico?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── Object storage (MinIO / S3) ─────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio123"
S3_BUCKET="fico-documents"
S3_REGION="eu-central-1"

# ─── Embeddings (OpenAI-compatible) ──────────────────────────────────────────
# Optional. Without a key /v1/retrieval answers searchable:false.
OPENAI_API_KEY=""
EMBEDDING_BASE_URL="https://api.openai.com/v1"
EMBEDDING_MODEL="text-embedding-3-small"
RETRIEVAL_TOP_K=8

# ── Open Finance / Wealth (AISP read-only) ──────────────────────────────────
FINAPI_BASE_URL="https://sandbox.finapi.io"
FINAPI_CLIENT_ID=""
FINAPI_CLIENT_SECRET=""
FINAPI_WEBHOOK_SECRET=""

TINK_BASE_URL="https://api.tink.com"
TINK_CLIENT_ID=""
TINK_CLIENT_SECRET=""

WEALTHAPI_BASE_URL="https://api.wealthapi.eu"
WEALTHAPI_CLIENT_ID=""
WEALTHAPI_CLIENT_SECRET=""

# ── finexpert.de/schnittstellen (all) ───────────────────────────────────────
# https://www.finexpert.de/schnittstellen/
FINEXPERT_BASE_URL="https://api.finexpert.de/api/v1"
FINEXPERT_CLIENT_ID=""
FINEXPERT_CLIENT_SECRET=""

BLAU_DIREKT_BASE_URL="https://api.finexpert.de/api/v1/blau-direkt"
BLAU_DIREKT_CLIENT_ID=""
BLAU_DIREKT_CLIENT_SECRET=""
BLAU_DIREKT_PARTNER_LICENSE_KEY=""

BCA_BASE_URL="https://api.finexpert.de/api/v1/bca"
BCA_CLIENT_ID=""
BCA_CLIENT_SECRET=""
BCA_PARTNER_LICENSE_KEY=""

FB_BASE_URL="https://api.finexpert.de/api/v1/fb"
FB_CLIENT_ID=""
FB_CLIENT_SECRET=""
FB_API_KEY=""

TAA_BASE_URL="https://api.finexpert.de/api/v1/taa"
TAA_CLIENT_ID=""
TAA_CLIENT_SECRET=""
TAA_API_KEY=""

MVP_BASE_URL="https://api.finexpert.de/api/v1/mvp"
MVP_CLIENT_ID=""
MVP_CLIENT_SECRET=""
MVP_API_KEY=""

# ── finanzmining / cashbuzz (analytics, predictions, contracts) ─────────────
# OpenAPI: cashbuzz platform API 1.2.1 — https://api.cashbuzz.io/v01
FINNANZMINING_BASE_URL="https://api.cashbuzz.io/v01"
FINNANZMINING_API_KEY=""
FINNANZMINING_USER_TOKEN=""

# ── Nettotarif / Honorar partners ───────────────────────────────────────────
# https://www.honorarkonzept.de/start.html
HONORARKONZEPT_BASE_URL="https://partner.honorarkonzept.de/api/v1"
HONORARKONZEPT_PARTNER_LICENSE_KEY=""
HONORARKONZEPT_API_KEY=""
HONORARKONZEPT_CLIENT_ID=""
HONORARKONZEPT_CLIENT_SECRET=""

# https://www.confee.de/
CONFEE_BASE_URL="https://partner.confee.de/api/v1"
CONFEE_PARTNER_LICENSE_KEY=""
CONFEE_API_KEY=""
CONFEE_CLIENT_ID=""
CONFEE_CLIENT_SECRET=""

API_PORT=3001
NODE_ENV=development

# ─── Regulatory ──────────────────────────────────────────────────────────────
AISP_HMAC_SECRET="change-me-in-production"

# ─── Worker ──────────────────────────────────────────────────────────────────
# Optional. Drives the document-ingestion concurrency (RAM_MB / 256).
WORKER_RAM_MB=1024

# ─── ElevenLabs (server side only — never expose to the browser) ─────────────
# Needed to mint a signedUrl for private agents and to read agents via API.
# A scoped key without convai_read/convai_write cannot create agents.
ELEVENLABS_API_KEY=""

# ─── Frontend (app/.env.local, not this file) ────────────────────────────────
# Vite only reads .env from app/ and only exposes VITE_* to the browser.
# VITE_API_BASE_URL=               # empty: the Vite proxy forwards /v1/*
# VITE_API_PROXY_TARGET=http://localhost:3001
# VITE_ELEVENLABS_AGENT_ID=agent_...
# VITE_DEMO_USER_ID=00000000-0000-4000-8000-000000000001
